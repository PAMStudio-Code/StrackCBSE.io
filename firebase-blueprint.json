{
  "entities": {
    "users": {
      "title": "User Accounts",
      "description": "User profile and target settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "schoolName": { "type": "string" },
        "targetBoardYear": { "type": "string" },
        "targetExamName": { "type": "string" },
        "boardExamDate": { "type": "string" },
        "dailyStudyGoalMinutes": { "type": "number" },
        "avatarEmoji": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "trackerData": {
      "title": "Student Tracker Data",
      "description": "Student study tasks, syllabus chapters, study sessions, quizzes, and virtual plants",
      "type": "object",
      "properties": {
        "profile": { "type": "object" },
        "chapters": { "type": "array" },
        "virtualPlants": { "type": "array" },
        "quizQuestions": { "type": "array" },
        "quizAttempts": { "type": "array" },
        "toDos": { "type": "array" },
        "studySessions": { "type": "array" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile document"
    },
    "/users/{userId}/trackerData/{docId}": {
      "schema": "trackerData",
      "description": "Student tracker tasks and progress document"
    }
  }
}
